      VALUE "OriginalFilename", "aram-mayhem.exe"
      VALUE "ProductName", "ARAM Mayhem"
      VALUE "ProductVersion", "0.2.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
